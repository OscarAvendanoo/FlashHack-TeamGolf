<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlashHackForum</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlashHackForum.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>
<body>

    <header>
        @{
            var userId = Context.Session.GetInt32("UserId");
            var user = Context.Session.GetString("UserName");
            var admin = Context.Session.GetInt32("IsAdmin");

        }
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm box-shadow" style="background:black;">
            <div class="container-fluid">
                <img src=@Url.Content("~/faviconNoBG/web-app-manifest-512x512.png") alt="Compaby logo" width="384" height="108" />
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between mt-3">
                    <ul class="navbar-nav flex-grow-1 mt-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Hem</a>
                        </li>

                        @if (!string.IsNullOrEmpty(user))
                        {
                            <li>
                                <div class="card mb-3" style="background-color: var(--orange);">
                                    <div class="row g-0 d-flex align-items-center">
                                        <!-- Användarnamn -->
                                        <div class="col-auto">
                                            <div class="card-body">
                                                <h6 class="card-title" style="color: var(--dark-blue);">@user</h6>
                                            </div>
                                        </div>

                                        <!-- Bildkolumn -->
                                        <div class="col-auto p-2">
                                            <img src="~/Images/userId1_image.gif" alt="profil bild" class="img-fluid rounded-start" style="max-height: 50px;">
                                        </div>

                                        <!-- Dropdown meny kolumn -->
                                        <div class="col-auto">
                                            <ul class="list-unstyled mb-0">
                                                @if (admin > 0)
                                                {
                                                    <!-- Admin Dropdown Menu -->
                                                    <li class="nav-item dropdown userMenu">
                                                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false"></a>
                                                        <ul class="dropdown-menu">
                                                            <li><a class="dropdown-item" asp-controller="User" asp-action="Details" asp-route-id=@userId>Min Profil</a></li>
                                                            <li><a class="dropdown-item" asp-controller="" asp-action="">Dashboard</a></li>
                                                            <li><a class="dropdown-item" asp-controller="" asp-action="">Användare</a></li>
                                                            <li><a class="dropdown-item" asp-controller="" asp-action="">Inställningar</a></li>
                                                            <li><a class="dropdown-item" asp-controller="User" asp-action="Logout">Logga ut</a></li>
                                                        </ul>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <!-- User Dropdown Menu -->
                                                    <li class="nav-item dropdown userMenu">
                                                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false"></a>
                                                        <ul class="dropdown-menu">
                                                            <li><a class="dropdown-item" asp-controller="User" asp-action="Details" asp-route-id=@userId>Min Profil</a></li>
                                                            <li><a class="dropdown-item" asp-controller="" asp-action="" asp-route-id=@userId>Inställningar</a></li>
                                                            <li><a class="dropdown-item" asp-controller="" asp-action="" asp-route-id=@userId>Skaffa Premium</a></li>
                                                            <li><a class="dropdown-item" asp-controller="User" asp-action="Logout">Logga ut</a></li>
                                                        </ul>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Auth" asp-action="Index">Logga in/ Nytt konto</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <nav class="navbar navbar-lower">

        <ul class="nav-list" style="display: flex">
            
            <!--Category Dropdown Menu-->
            @await Component.InvokeAsync("CategoryMenu")
            
            @if (!string.IsNullOrEmpty(user))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Favourite" asp-action="ListMyFavourites">Mina Favoriter</a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Favourite" asp-action="ListAllFavourites">Favoriter</a>
                </li>
            }

            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Favourite" asp-action="ListMyThreads">Mina trådar</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Karriär och jobb</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="ForumThread" asp-action="Index">Trådar</a>
            </li>
        </ul>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - FlashHackForum - <a class="a-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>



