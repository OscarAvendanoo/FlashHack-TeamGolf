@model IEnumerable<MainCategory>

<li class="nav-item dropdown userMenu">
    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false" style="color:var(--orange);">Avdelningar</a>
    <ul class="dropdown-menu">

        @foreach (var item in Model)
        {
            <li class="dropdown-submenu">
                <a class="dropdown-item" asp-controller="" asp-action="" value="@item.MainCategoryId">@item.Name</a>

                @if (item.SecondCategories != null)
                {
                    <ul class="dropdown-menu">
                        @foreach (var secondItem in item.SecondCategories)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="ForumThread" asp-action="ListForumThread" asp-route-id="@secondItem.SecondCategoryId">@secondItem.Name</a>
                            </li>
                        }
                    </ul>
                }
            </li>

        }
        


        <li><a class="dropdown-item" asp-controller="User" asp-action="Logout">Logga ut</a></li>
    </ul>
</li>
