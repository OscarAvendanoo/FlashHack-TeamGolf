@model IEnumerable<MainCategory>

<li class="nav-item dropdown userMenu">
    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">Avdelningar</a>
    <ul class="dropdown-menu">

        @foreach (var item in Model)
        {
            <li class="dropdown-submenu">
                <a asp-controller="" asp-action="" value="@item.MainCategoryId">@item.Name</a>

                @if (item.SecondCategories != null)
                {
                    <ul class="dropdown-menu">
                        @foreach (var secondItem in item.SecondCategories)
                        {
                            <li>
                                <a asp-controller="Favourite" asp-action="ListAllThreadsByCategory" asp-route-id="@secondItem.SecondCategoryId">@secondItem.Name</a>
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ul>
</li>
