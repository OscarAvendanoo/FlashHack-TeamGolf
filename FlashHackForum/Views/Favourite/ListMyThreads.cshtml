@using X.PagedList

@model PagedList<FlashHackForum.Models.ForumThread>

@{
    ViewData["Title"] = "ListAllFavourites";
    int currentPage = ViewBag.CurrentPage ?? 1;
}

<h3>Mina inlägg</h3>
<br />
<hr />

<div class="list-group custom-list">
@foreach (var item in Model)
{
        <div class="list-group-item">
            <div class="d-flex w-100 justify-content-between">
                <h5 class="mb-1">@Html.DisplayFor(modelItem => item.Title)</h5>
                <small>@Html.DisplayFor(modelItem => item.CreatedAt)</small>
            </div>
            <p>@Html.DisplayFor(modelItem => item.ThreadCreator.Signature)</p>

            <!-- Button Container (Floating Right) -->
            <div class="d-flex justify-content-end mt-2">
                <a asp-action="EditByOwner" asp-controller="ForumThread" asp-route-id="@item.ForumThreadID" class="btn btn-primary btn-sm me-2">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="DeleteByOwner" asp-controller="ForumThread" asp-route-id="@item.ForumThreadID" class="btn btn-danger btn-sm">
                    <i class="bi bi-trash"></i> Delete
                </a>
            </div>
        </div>
}
</div>

<nav aria-label="Page navigation example" >
    <ul class="pagination">
        <li class="page-item">
            <a class="page-link" href="@Url.Action("ListAllFavourites", new { page = 1 })" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
        <li class="page-item @(currentPage == 1 ? "active" : "")"><a class="page-link" href="@Url.Action("ListAllFavourites", new { page = 1 })">1</a></li>
        <li class="page-item @(currentPage == 2 ? "active" : "")"><a class="page-link" href="@Url.Action("ListAllFavourites", new { page = 2 })">2</a></li>
        <li class="page-item @(currentPage == 3 ? "active" : "")"><a class="page-link" href="@Url.Action("ListAllFavourites", new { page = 3 })">3</a></li>
        <li class="page-item">
            <a class="page-link" href="@Url.Action("ListAllFavourites", new { page = 2 })" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
    </ul>
</nav>
