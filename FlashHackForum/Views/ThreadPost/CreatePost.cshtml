@model FlashHackForum.ViewModels.CreatePostVM

@{
}
<div style="width:10em; height: 10em;"></div>
<div class="container mt-4">
    <h2 class="mb-3 ms-2">Skapa ett nytt inlägg</h2>

    <form asp-action="CreatePost" method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="ThreadId" />

        <div>
            <label class="form-label">Ditt inlägg:</label>
            <textarea asp-for="PostMessage" class="form-control" rows="4" required></textarea>
        </div>
        <div class="form-check mb-4 mt-4">
            <input type="checkbox" asp-for="Anonymous" class="form-check-input" />
            <label class="form-check-label" asp-for="Anonymous">Post Anonymously</label>
        </div>
        <div class="d-flex justify-content-start gap-3">
            <button type="submit" class="btn btn-primary">Skicka</button>
            <a asp-controller="ForumThread" asp-action="ShowThread" asp-route-id="@Model.ThreadId" class="btn btn-secondary">Avbryt</a>
        </div>
       
    </form>

    @if (!ViewData.ModelState.IsValid)

    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(false)
        </div>
    }
</div>