@model FlashHackForum.ViewModels.UserLoginViewModel

@{
    ViewData["Title"] = "Index";
}


<h1>Logga in</h1>
<form method="post">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div class="row">
        <div class="">
            <label for="email">Email</label>
        </div>
        <div class="col-md-4">
            <input type="email" class="form-control " id="email" name="Email" required />
        </div>
    </div>
    <div class="row">
        <div>
            <label for="password">Lösenord</label>
        </div>
        <div class="col-md-4">
            <input type="password" class="form-control" id="password" name="Password" required />
        </div>
    </div>
    <span class="text-danger">@ViewData["Message"]</span>

    <span class="text-danger">@ViewBag.Error</span>
    <div>
        <button type="submit" asp-action="Login" class="btn main-btn mt-3">Login</button>
        <a asp-controller="User" asp-action="Registration" class=" btn main-btn mt-3">Skapa konto</a>
    </div>
</form>