@model FlashHackForum.ViewModels.ForumThreadViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Skapa tråd</h1>


<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <!--Gjorde en liten uppdatering (inte snygg) men gjorde så valet som visas och läggs in i redan är förinställt om man går via tråden för att skapa ny tråd-->
            <!--// Kevin :))-->
            <!-- Dropdown för SecondCategoryId -->
            <div class="form-group">
                <label asp-for="SecondCategoryId" class="control-label">Kategori</label>
                <select asp-for="SecondCategoryId" class="form-control">
                    @if(Model.SecondCategoryId != null)
                    {
                        <option value="@ViewBag.SecondCategory">@ViewBag.SecondCategoryName</option>

                    }
                    else
                    {
                        <option value="">Välj kategori</option>
                    }
                    @foreach (var category in Model.SecondCategories)
                    {
                        
                        <option value="@category.SecondCategoryId">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="SecondCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="ThreadPost.PostMessage">Skriv första inlägget:</label>
                <textarea asp-for="ThreadPost.PostMessage" class="form-control"></textarea>
                <span asp-validation-for="ThreadPost.PostMessage" class="text-danger"></span>
            </div>
            <div class="form-check mb-4 mt-4">
                <input type="checkbox" asp-for="Anonymous" class="form-check-input" />
                <label class="form-check-label" asp-for="Anonymous">Posta anonymt</label>
            </div>
            <div class="form-check mb-4 mt-4">
                <input type="checkbox" asp-for="ShowSignature" class="form-check-input" />
                <label class="form-check-label" asp-for="ShowSignature">Posta signatur</label>
            </div>

            <div class="form-group">
                <input type="submit" value="Skapa tråd" class="btn main-btn" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-controller="Home" asp-action="Index" class="a-link">Back to Homepage</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
