@model FlashHackForum.ViewModels.ForumThreadViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>ForumThread</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Dropdown för SecondCategoryId -->
            <div class="form-group">
                <label asp-for="SecondCategoryId" class="control-label"></label>
                <select asp-for="SecondCategoryId" class="form-control">
                    <option value="">Välj kategori</option>
                    @foreach (var category in Model.SecondCategories)
                    {
                        <option value="@category.SecondCategoryId">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="SecondCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="ThreadPost.PostMessage">Skriv första inlägget:</label>
                <textarea asp-for="ThreadPost.PostMessage" class="form-control"></textarea>
                <span asp-validation-for="ThreadPost.PostMessage" class="text-danger"></span>
            </div>
            <div class="form-check mb-2 mt-2">
                <input type="checkbox" asp-for="Anonymous" class="form-check-input" />
                <label class="form-check-label" asp-for="Anonymous">Create Anonymously</label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
