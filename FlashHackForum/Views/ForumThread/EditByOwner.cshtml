@model FlashHackForum.ViewModels.EditThreadVM

@{
    ViewBag.Title = "Edit Thread";
}
<div style="width:10em; height: 10em;"></div>
<div class="container mt-4">
    <h2 class="mb-3 ms-2">Redigera tråd</h2>

    <form asp-action="EditByOwner" method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="ThreadToEditId"/>
        <div class="mb-3">
            <label class="form-label">Titel:</label>
            <input type="text" asp-for="Desrciption" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Diskussion:</label>
            <textarea asp-for="FirstPostMessage" class="form-control" rows="4" required></textarea>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" asp-for="IsAnonymous" class="form-check-input" />
            <label class="form-check-label" asp-for="IsAnonymous">Håll mig anonym</label>
        </div>
        <div class="form-check mb-3">
            <input type="checkbox" asp-for="IsShowSignature" class="form-check-input" />
            <label class="form-check-label" asp-for="IsShowSignature">Post signature</label>
        </div>

        <div class="d-flex justify-content-start gap-3">
            <button type="submit" class="btn main-btn">Spara</button>
            <a asp-controller="Favourite" asp-action="ListMyThreads" class="btn btn-secondary">Avbryt</a>
        </div>
    </form>
    @if (!ViewData.ModelState.IsValid)

    {
        <div class="alert alert-danger mt-2">
            @Html.ValidationSummary(false)
        </div>
    }
</div>