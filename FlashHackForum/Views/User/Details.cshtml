@model FlashHackForum.Models.User

@{
    ViewData["Title"] = "Details";
    var userId = Context.Session.GetInt32("UserId");
}



@if(userId == Model.UserId)
{
    <h2>Min Profil
        @if(!string.IsNullOrEmpty(Model.Account.ProfileImage))
        {
            @*<img src="@Model.Account.ProfileImage" class="img-thumbnail" alt="Profil bild"/>*@
            <img src="~/Images/userId1_image.gif" class="img-fluid" alt="Profil bild" />
            
        }
        else
        {
            <a>Bild saknas</a>
        }
    </h2>

    <div>
        <h4>Användar uppgifter</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                <a>Förnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FirstName)
            </dd>
            <dt class="col-sm-2">
                <a>Efternamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.LastName)
            </dd>
            <dt class="col-sm-2">
                <a>Användarnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.UserName)
            </dd>
            <dt class="col-sm-2 visually-hidden">
                <a>Administratör? </a>
            </dt>
            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.IsAdmin)
            </dd>
            <dt class="col-sm-2">
                <a>Email </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Email)
            </dd>

            <dt class="col-sm-2">
                Lösenord:
            </dt>
            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.Password)
            </dd>
            <dd>
                <a class="btn btn-primary" asp-route-id="@Model?.UserId">Ändra lösenord</a>
            </dd>

            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.AccountId)
            </dd>

            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.Account)
            </dd>
        </dl>

        <h4>Konto uppgifter</h4>
        <dl class="row">
            <dt class="col-sm-2">
                <a>Konto skapades: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.AccountCreatedAt)
            </dd>
            <dt class="col-sm-2">
                <a>Premium konto? </a>
            </dt>
            @if (Model.Account.IsPremium)
            {
                <dd class="col-sm-10">
                    <a>Ja</a>
                </dd>
            }
            else
            {
                <dd class="col-sm-10">
                    <a>Nej</a>
                </dd>
            }

            <dt class="col-sm-2">
                <a>Om mig: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Biography)
            </dd>
            <dt class="col-sm-2">
                <a>Signatur</a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Signature)
            </dd>
            <dt class="col-sm-2">
                <a>Telefon</a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.PhoneNumber)
            </dd>
            <dt class="col-sm-2">
                <a>Arbetsgivare: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Employer)
            </dd>
          
            <dt class="col-sm-2">
                <a>Ranking: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.AccountRating)
            </dd>
            <dt class="col-sm-2">
                <a>Konto email:  </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Email)
            </dd>
            <dt class="col-sm-2">
                <a>Profilnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.DisplayName)
            </dd>
            <dt class="col-sm-2 visually-hidden">
                @Html.DisplayNameFor(model => model.Account.Email)
            </dt>
            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.Account.Email)
            </dd>
            <hr />

            <h4>Inställningar: </h4>
            <dt class="col-sm-2">
                <a>Visa annonser? </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.ShowAdvertisements)
            </dd>
            <dt class="col-sm-2">
                <a>Synlig profil? </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.ShowContact)
            </dd>
            <dt class="col-sm-2">
                <a>Synlig för företag? </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.ShowToCompanies)
            </dd>
        </dl>
    </div>
    <div>
        <a asp-action="" asp-route-id="@Model?.UserId">Redigera användare</a> |
        <a asp-action="" asp-route-id="@Model?.Account.AccountId">Redigera konto</a>
    </div>
}
else
{
    <h2>
        @Model.UserName
        @if (!string.IsNullOrEmpty(Model.Account.ProfileImage))
        {
            @*<img src="@Model.Account.ProfileImage" class="img-thumbnail" alt="Profil bild"/>*@
            <img src="~/Images/userId1_image.gif" class="img-thumbnail" alt="Profil bild" />
        }
        else
        {
            <a>Bild saknas</a>
        }
    </h2>

    <div>
        <h4>Användar uppgifter</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                <a>Förnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FirstName)
            </dd>
            <dt class="col-sm-2">
                <a>Efternamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.LastName)
            </dd>
            <dt class="col-sm-2">
                <a>Användarnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.UserName)
            </dd>
            <dt class="col-sm-2 visually-hidden">
                <a>Administratör? </a>
            </dt>
            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.IsAdmin)
            </dd>
            <dt class="col-sm-2">
                <a>Email </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Email)
            </dd>

            <dt class="col-sm-2 visually-hidden">
                Lösenord:
            </dt>
            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.Password)
            </dd>
            
            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.AccountId)
            </dd>

            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.Account)
            </dd>
        </dl>

        <h4>Konto uppgifter</h4>
        <dl class="row">
            <dt class="col-sm-2">
                <a>Konto skapades: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.AccountCreatedAt)
            </dd>
            
            <dt class="col-sm-2">
                <a>Om @Model.FirstName: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Biography)
            </dd>
            <dt class="col-sm-2">
                <a>Telefon</a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.PhoneNumber)
            </dd>
            <dt class="col-sm-2">
                <a>Arbetsgivare: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Employer)
            </dd>       

            <dt class="col-sm-2">
                <a>Ranking: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.AccountRating)
            </dd>
            <dt class="col-sm-2">
                <a>Konto email:  </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Email)
            </dd>
            <dt class="col-sm-2">
                <a>Profilnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.DisplayName)
            </dd>
            <dt class="col-sm-2 visually-hidden">
                @Html.DisplayNameFor(model => model.Account.Email)
            </dt>
            <dd class="col-sm-10 visually-hidden">
                @Html.DisplayFor(model => model.Account.Email)
            </dd>
            <hr />
        </dl>
    </div>
}

