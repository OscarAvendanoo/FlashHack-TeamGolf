@model FlashHackForum.Models.User

@{
    ViewData["Title"] = "Details";
    var userId = Context.Session.GetInt32("UserId");
    var errorMessage = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger col-md-4">
        @errorMessage
    </div>
}
<hr />

<!-- Följande data visas om användaren besöker sin profilsida -->
@if(userId == Model.UserId)
{
    <div class="row g-3 rounded" style="background-color: var(--dark-blue); color: var(--orange)">
        <h2>
            @Model.UserName
            @if (!string.IsNullOrEmpty(Model.Account.ProfileImage))
            {
                @*<img src="@Model.Account.ProfileImage" class="img-thumbnail" alt="Profil bild"/>*@
                <img src="~/Images/userId1_image.gif" class="img-fluid rounded-circle" alt="Profil bild" />
            }
            else
            {
                <a>Bild saknas</a>
            }
        </h2>
        <!-- Lägg till formulär för att redigera användardata -->
        <h4>Användaruppgifter</h4>
        <form asp-action="Edit" method="post" class="row g-3">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="AccountId" />
            <input type="hidden" asp-for="Password" />
            <input type="hidden" asp-for="Account.ProfileImage" />

            <div class="col-md-6 form-group">
                <label class="form-label" for="FirstName">Förnamn</label>
                <input type="text" asp-for="FirstName" class="form-control" />
            </div>

            <div class="col-md-6 form-group">
                <label class="form-label" for="LastName">Efternamn</label>
                <input type="text" asp-for="LastName" class="form-control" />
            </div>

            <div class="col-md-6 form-group">
                <label for="UserName">Användarnamn</label>
                <input asp-for="UserName" class="form-control" />
            </div>

            <div class="col-md-6 form-group">
                <label for="Email">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="col-md-6 form-group">
                <label for="Password">Lösenord</label>
                <div class="input-group">
                    <input for="Password" placeholder=@Model.Password class="form-control" disabled readonly />
                    <button class="btn btn-primary border-0" style="background-color: var(--orange);" type="button" asp-action="" asp-route-id="@Model?.UserId">Ändra lösenord</button>
                </div>
            </div>
            <div class="col-md-6 form-group">
                <label for="IsAdmin">Administratör?</label>
                @if (Model.IsAdmin)
                {
                    <input class="form-control" type="text" value="Ja" disabled readonly>
                }
                else
                {
                    <input class="form-control" type="text" value="nej" disabled readonly>
                }
            </div>

            <hr />
            <!-- Lägg till formulär för att redigera kontodata -->
            <h4>Konto uppgifter</h4>
            <div class="col-md-6 form-group">
                <label for="Account.AccountCreatedAt">Konto skapades</label>
                <input asp-for="Account.AccountCreatedAt" class="form-control" disabled readonly />
            </div>
            <div class="col-md-6 form-group">
                <label for="Account.DisplayName">Profilnamn</label>
                <input asp-for="Account.DisplayName" class="form-control" />
            </div>

            <div class="col-md-6 form-group">
                <label for="Account.PhoneNumber">Telefonnummer</label>
                <input asp-for="Account.PhoneNumber" class="form-control" />
            </div>

            <div class="col-md-6 form-group">
                <label for="Email">Konto Email</label>
                <input asp-for="Account.Email" class="form-control" />
            </div>

            <div class="col-md-6 form-group">
                <label for="Account.Employer">Arbetsgivare</label>
                <input asp-for="Account.Employer" class="form-control" />
            </div>

            <!-- Premium Konto Rubrik -->
            <div class="col-md-6 form-group">
                <div class="row">
                    <div class="col-md-3">
                        <label for="Account.IsPremium">Premium konto?</label>
                    </div>

                    @if (Model.Account.IsPremium)
                    {
                        <!-- Ja om Premium -->
                        <div class="col-md-3">
                            <input class="form-control" type="text" value="Ja" disabled readonly>
                        </div>
                        <!-- Konto Ranking -->
                        <div class="col-md-3">
                            <label for="Account.AccountRating">Ranking</label>
                        </div>
                        <!-- Ranking värde -->
                        <div class="col-md-3">
                            <input asp-for="Account.AccountRating" class="form-control" disabled readonly />
                        </div>
                    }
                    else
                    {
                        <!-- Knapp för att Skaffa Premium -->
                        <div class="col-md-6">
                            <button class="btn btn-primary border-0" style="background-color: var(--orange);" type="button" asp-action="" asp-route-id="@Model?.AccountId">Skaffa Premium</button>
                        </div>
                    }
                </div>
            </div>

            <!-- Kompetenser Sektion -->
            <div class="row mt-3 col-md-12">
                <div class="col-auto form-group">
                    <h5>Kompetenser</h5>
                    <table class="table table-borderless" style="color: var(--orange);">
                        <thead>
                            <tr>
                                <th>Typ</th>
                                <th>Kunskapsnivå</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Account.UserCompetences.Count > 0)
                            {
                                foreach (var competence in Model.Account.UserCompetences)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => competence.Competens.Title)</td>
                                        <td>@Html.DisplayFor(modelItem => competence.Grade)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">Inga valda kompetenser</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                    <!-- Knapp för att lägga till fler kompetenser -->
                    <a class="btn btn-primary border-0" style="background-color: var(--orange);" type="button" asp-controller="Account" asp-action="AddCompetences" asp-route-id="@Model?.AccountId">Lägg till kompetens</a>
                </div>
            </div>
                
            <div class="col-md-6 form-group">
                <label for="Account.Biography">Om mig</label>
                <textarea asp-for="Account.Biography" class="form-control" type="text" rows="5">@Model.Account?.Biography</textarea>
            </div>
            <div class="col-md-6 form-group">
                <label for="Account.Signature">Signatur</label>
                <textarea asp-for="Account.Signature" class="form-control" type="text" rows="3">@Model.Account?.Signature</textarea>
            </div>

            <!-- Formulär för att redigera inställningar -->
            @if (Model.Account.IsPremium)
            {
                <h4>Inställningar: </h4>
                <div>
                    <ul class="list-unstyled">
                        <li>
                            <div class="form-check form-switch col-md-6 form-group">
                                <label class="form-check-label" for="flexSwitchCheckDefault">Visa annonser?</label>
                                <input asp-for="Account.ShowAdvertisements" class="form-check-input" type="checkbox" role="switch">
                            </div>
                            <div class="form-check form-switch col-md-6 form-group">
                                <label class="form-check-label" for="flexSwitchCheckDefault">Synlig profil?</label>
                                <input asp-for="Account.ShowContact" class="form-check-input" type="checkbox" role="switch">
                            </div>
                            <div class="form-check form-switch col-md-6 form-group">
                                <label class="form-check-label" for="flexSwitchCheckDefault">Synlig för företag?</label>
                                <input asp-for="Account.ShowToCompanies" class="form-check-input" type="checkbox" role="switch">
                            </div>
                        </li>
                    </ul>

                </div>
            }
            
           <div class="mb-3">
                <button type="submit" class="btn btn-primary" style="background-color: var(--orange)">Spara</button>
           </div>
            
        </form>
    </div>
}
<!-- Följande data visas om någon annan besöker användarens profilsida -->
else
{
    <h2>
        @Model.UserName
        @if (!string.IsNullOrEmpty(Model.Account.ProfileImage))
        {
            @*<img src="@Model.Account.ProfileImage" class="img-thumbnail" alt="Profil bild"/>*@
            <img src="~/Images/userId1_image.gif" class="img-fluid rounded-circle" alt="Profil bild" />
        }
        else
        {
            <a>Bild saknas</a>
        }
    </h2>

    <div>

        <dl class="row">
            <dt class="col-sm-2">
                <a>Profilnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.DisplayName)
            </dd>
            <dt class="col-sm-2">
                <a>Förnamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.FirstName)
            </dd>
            <dt class="col-sm-2">
                <a>Efternamn: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.LastName)
            </dd>
            <dt class="col-sm-2">
                <a>Konto skapades: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.AccountCreatedAt)
            </dd>
            <dt class="col-sm-2">
                <a>Arbetsgivare: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Employer)
            </dd>

            <dt class="col-sm-2">
                <a>Telefon</a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.PhoneNumber)
            </dd>
            <dt class="col-sm-2">
                <a>Email: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Email)
            </dd>
            
            <dt class="col-sm-2">
                <a>Om @Model.FirstName: </a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.Biography)
            </dd>

            <dt class="col-sm-2">
                <a>Kompetenser:</a>
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Account.UserCompetences)
            </dd>
        </dl>
    </div>
}


